{
  "manifest_version": 3,
  "name": "Auto Pack for WikiMasters (unofficial)",
  "version": "1.0.0",
  "description": "Unofficial helper for wiki-masters.com: auto pack opening, collection tracking, marketplace filter, sales and auto-bidding.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.wiki-masters.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wiki-masters.com/*"
      ],
      "js": [
        "content.js",
        "collection.js",
        "sell.js",
        "bid.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Pack (wiki-masters.com only)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-pack-wikimasters@maximebranger.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}